# Copy this file to ".env" and fill in real values:
#     cp .env.example .env        (macOS/Linux/WSL)
#     copy .env.example .env      (Windows CMD)
#
# The .env file is git-ignored and must NEVER be committed. This template IS
# committed so everyone knows which variables the project needs.

# --- PostgreSQL database ---
# POSTGRES_HOST must be "db" when running via docker compose: that is the
# service name of the Postgres container, which Compose exposes as a hostname.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# --- Map API ---
# Paste your personal map provider API key here in your local .env.
# Leave blank until we've picked/registered a provider.
MAP_API_KEY=
